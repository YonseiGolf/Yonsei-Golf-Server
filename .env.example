# Local development only. Replace with your own values for production.
APP_PROFILE=home
PORT=8080
COOKIE_SECURE=false
DATABASE_URL=mysql://127.0.0.1:3307/yg_local
DATABASE_USERNAME=yg_local
DATABASE_PASSWORD=yg_local_password
DATABASE_SSL=false
# Base64 of 32+ random bytes; this published value is ONLY for local development.
JWT_SECRET_KEY=dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHQ=
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_TOKEN_URL=https://kauth.kakao.com/oauth/token
KAKAO_LOGIN_URI=https://kapi.kakao.com/v2/user/me
# KAKAO_CALLBACK_URL must match the redirect_uri used when getting the auth code.
# KAKAO_CALLBACK_URL=http://localhost:3000/oauth/kakao
CORS_ORIGINS=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@yonsei-golf.kr
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=yg-local
AWS_S3_PUBLIC_URL=http://localhost:9000
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=local-minio
AWS_SECRET_ACCESS_KEY=local-minio-password
