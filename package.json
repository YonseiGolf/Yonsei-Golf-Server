{
  "name": "yonsei-golf-server",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.11.0 <26"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm test:integration",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/test/integration.test.js",
    "test:container": "tsc -p tsconfig.test.json && node --test .test-dist/test/runtime-smoke.test.js",
    "docker:build": "docker build --target runtime -t yonsei-golf-server:nestjs-local . && docker build --target migrations -t yonsei-golf-server:flyway-local .",
    "db:up": "docker compose up -d mysql mailpit minio minio-init",
    "db:migrate": "docker compose run --rm flyway migrate",
    "db:validate": "docker compose run --rm flyway validate",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@testcontainers/mysql": "12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "smtp-server": "^3.19.12",
    "supertest": "^7.2.2",
    "testcontainers": "12.1.0",
    "typescript": "5.9.3"
  }
}
